# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit real values.

# --- Required everywhere -----------------------------------------------------

# Signs login sessions. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# The Owner (highest-level admin) account, created the first time the database
# is seeded. Only used when no owner exists yet. Password: at least 8 characters.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Required in production (Vercel) ----------------------------------------

# Postgres connection string (Neon, Supabase, Vercel Postgres, ...). Use the
# POOLED connection string on serverless hosts.
# Leave empty for local development: an embedded database is created in .data/
DATABASE_URL=

# --- Optional ----------------------------------------------------------------

# Public URL of the site, used for canonical links, Open Graph and the sitemap.
# On Vercel this is detected automatically; set it when using a custom domain.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Maximum Postgres connections per server instance (default 5).
DATABASE_POOL_MAX=
